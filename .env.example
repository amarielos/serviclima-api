# Copiar como .env antes de iniciar la API.
# .env no se publica. En Render se configura ORIGEN_FRONTEND en Environment.
# PORT lo proporciona Render y tiene prioridad sobre PUERTO; no definirlo allí.
PUERTO=3001
# En producción: origen real del frontend, sin ruta ni barra final.
ORIGEN_FRONTEND=http://localhost:5173

# Opcional: ruta de una base alternativa (por defecto datos/serviclima.db).
# RUTA_DB=C:/ruta/alternativa/serviclima.db
